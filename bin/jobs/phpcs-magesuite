#!/bin/bash
printf "\033[34mPHP Code Sniffer for MageSuite\033[00m"
printf "\n\n"

GITDIFFFILE=$(mktemp)
( cd $1 && git diff origin/HEAD --diff-filter=d '*.php' > $GITDIFFFILE ) >> /dev/null

PHPCSFILE=$(mktemp)
$2/vendor/bin/phpcs $2/$1 --standard=$2/vendor/creativestyle/magesuite-coding-standards/MageSuite --report=json --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 > $PHPCSFILE

$2/vendor/bin/diffFilter --phpcsStrict $GITDIFFFILE $PHPCSFILE

rm $GITDIFFFILE $PHPCSFILE
