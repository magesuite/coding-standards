#!/bin/bash
printf "\033[34mPHP Mess Detector\033[00m"
printf "\n\n"

changed_files=$(cd $1 && git diff origin/HEAD --name-only --diff-filter=d '*.php' ':!*Test.php' | sed -e "s#^#$2/$1#g" | awk '{print}' ORS=',' | sed 's/,$/\n/')

$2/vendor/bin/phpmd $changed_files text $2/vendor/creativestyle/magesuite-coding-standards/phpmd.xml --color
